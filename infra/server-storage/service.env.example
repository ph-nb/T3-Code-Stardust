# Replace the placeholders; this file belongs in <T3 home>/service.env with mode 0600.
T3CODE_DATABASE_BACKEND=postgres
T3CODE_DATABASE_URL=postgresql://stardust:REPLACE_DB_PASSWORD@127.0.0.1:5432/stardust
T3CODE_POSTGRES_SCHEMA=stardust
T3CODE_POSTGRES_POOL_SIZE=8
T3CODE_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0
T3CODE_CACHE_NAMESPACE=stardust
T3CODE_CACHE_TTL_SECONDS=90
T3CODE_CACHE_MAX_BYTES=1048576
