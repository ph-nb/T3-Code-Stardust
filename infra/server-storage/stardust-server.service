[Unit]
Description=Stardust single-instance server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=stardust
Group=stardust
StateDirectory=stardust
WorkingDirectory=/var/lib/stardust
EnvironmentFile=/etc/stardust-server.env
Environment=T3CODE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD=false
ExecStart=/opt/stardust-server/t3 serve --base-dir /var/lib/stardust --host 127.0.0.1 --port 3773 --no-browser
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
